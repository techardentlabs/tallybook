    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "release:build": "pnpm --filter @tallybook/desktop tauri build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.7.0",
  "homepage": "https://tallybook.online",
  "repository": {
    "type": "git",
