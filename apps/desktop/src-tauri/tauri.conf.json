{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TallyBook",
  "version": "0.1.2",
  "identifier": "online.tallybook.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TallyBook",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Techardent",
    "category": "Finance",
    "shortDescription": "Keyboard-first accounting with Tally-style workflow",
    "copyright": "© Techardent",
    "homepage": "https://tallybook.online"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4NzYwRUQ3NTEzRUIxQkEKUldTNnNUNVIxdzUybUMyRlU2QnRjR0s4Q2xIa3A0MjNHa2FEbDZEV1VaSlNNNzR4SHdjdTlhSG4K",
      "endpoints": [
        "https://github.com/techardentlabs/tallybook/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
